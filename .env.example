# Copy to .env and fill in. .env is gitignored.
#
# Which model the harness runs on. The "<provider>:" prefix is mandatory -
# without it no harness profile resolves and Deep Agents' built-in filesystem
# and shell tools stay enabled. `python agent.py --check-tools` asserts this.
HARNESS_MODEL=anthropic:claude-opus-5

# The key for whichever provider HARNESS_MODEL names. Deep Agents reaches a
# provider through its langchain integration, which authenticates with an API
# key only - a Claude Code or subscription login cannot be reused.
# Anthropic keys: https://platform.claude.com/
ANTHROPIC_API_KEY=

# Temporary alternative while waiting on an Anthropic key. Set both
# HARNESS_MODEL=google_genai:<model> and this key.
# Note: eval.py prices Anthropic tokens, so its cost column is wrong for any
# other provider. Accuracy is still measured correctly.
# GOOGLE_API_KEY=
